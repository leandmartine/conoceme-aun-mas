# Backend
PORT=8787
HOST=0.0.0.0
NODE_ENV=development
CONTENT_ROOT=./content
CORS_ORIGIN=http://localhost:5173

# Production only: serve Vite build from the API process (same origin).
# STATIC_ROOT=./apps/frontend/dist

# API keys for AI companion (comma-separated). Never commit real secrets for private keys.
PORTFOLIO_API_KEYS=dev-local-key

# Public key for the in-game companion (rate-limited). Exposed via GET /ai/status.
# In prod (Railway) set this; FE picks it up without rebuild.
PUBLIC_COMPANION_KEY=dev-local-key

# Optional: SpaceXAI / xAI for future LLM mode (server-only; never expose to browser).
# XAI_API_KEY=
# AI_RATE_LIMIT_MAX=30
# AI_RATE_LIMIT_WINDOW_MS=60000

# Frontend (Vite) local override — optional if PUBLIC_COMPANION_KEY is set on API
# VITE_PORTFOLIO_API_KEY=dev-local-key
