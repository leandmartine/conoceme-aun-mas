# Copy to .env next to docker-compose.yml on the NAS
#   cp deploy/nas.env.example .env

# Prebuilt image (after GitHub Actions publishes it)
IMAGE=ghcr.io/leandmartine/conoceme-aun-mas:latest

# Port on the NAS host
HOST_PORT=8787

# Companion chat (public + rate-limited). Generate: openssl rand -hex 16
PUBLIC_COMPANION_KEY=change-me-on-nas

# Optional extra private keys (comma-separated)
# PORTFOLIO_API_KEYS=

CORS_ORIGIN=*
AI_RATE_LIMIT_MAX=30
